# Ant Browser container settings.
# Copy to .env next to docker-compose.yml and adjust.

TZ=Asia/Shanghai

# Static IP on the host's existing ipvlan network (bond4, 192.168.0.0/22).
# Must be free — check with `ping` and `docker network inspect bond4`.
ANT_IP=192.168.2.201

# Display geometry. The app window wants 1750x1000 and refuses to go under
# 1200x700, so keep this at 1280x800 or above.
CUSTOM_RES_W=1600
CUSTOM_RES_H=900
CUSTOM_DEPTH=24

# noVNC tuning: resize = off | scale | remote, quality/compression 0-9.
NOVNC_RESIZE=scale
NOVNC_QUALITY=6
NOVNC_COMPRESSION=2

# Start the GUI app automatically. Set to 0 to bring the container up with only
# the display stack, then run `docker exec antbrowser antctl start` by hand.
ANT_AUTOSTART=1

# Launch API relay.
#
# The app binds 127.0.0.1:19876 and rejects every non-localhost caller. Setting
# this to 1 runs socat inside the container to forward LAN traffic from
# ANT_API_RELAY_PORT to that local port, which re-originates the request as
# 127.0.0.1 and therefore bypasses that check.
#
# Anyone on the LAN can then drive the browser and reach the CDP endpoint.
# Set to 0 to keep the API container-local, or enable API-key auth in the app's
# settings page (launch_server.auth) before leaving this on long term.
ANT_API_RELAY=1
ANT_API_RELAY_PORT=19877

# Unraid's nobody:users.
PUID=99
PGID=100
UMASK=000
